# Copy to .env and edit (do not commit .env):
#   cp .env.example .env
#
# Local (SQLite / make run): leave LINKGEAR_DSN unset or use sqlite://…
# Production (docker-compose.prod.yml): fill Postgres vars below, then:
#   docker compose -f docker-compose.prod.yml up -d
#
# Compose auto-loads project-dir `.env` for ${VAR} interpolation — no --env-file needed.

# --- App ---
LINKGEAR_HTTP_ADDR=:8080
# Local default:
LINKGEAR_PUBLIC_URL=http://localhost:8080
# Production example:
# LINKGEAR_PUBLIC_URL=https://link.wududu.com

# SQLite (dev/test) — default in binary if unset
# LINKGEAR_DSN=sqlite://./data/linkgear.db

# Host port mapping → container 8080 (prod compose)
LINKGEAR_HOST_PORT=8080

# Image tag from Docker Hub (Jenkins also tags :<short-sha>-<YYYYMMDD>)
LINKGEAR_IMAGE_TAG=latest

# Optional delivery tuning (defaults match binary)
# LINKGEAR_DELIVERY_WORKERS=8
# LINKGEAR_DELIVERY_POLL=2s

# --- Production: bundled Postgres (docker-compose.prod.yml) ---
# Keep POSTGRES_PASSWORD in sync with the password embedded in LINKGEAR_DSN.
POSTGRES_USER=linkgear
POSTGRES_PASSWORD=change-me-to-a-strong-secret
POSTGRES_DB=linkgear

# App DSN. Host "db" is the compose service name when using bundled Postgres.
LINKGEAR_DSN=postgres://linkgear:change-me-to-a-strong-secret@db:5432/linkgear?sslmode=disable

# External Postgres instead: set LINKGEAR_DSN to your URL, then:
#   docker compose -f docker-compose.prod.yml up -d --no-deps linkgear
# LINKGEAR_DSN=postgres://linkgear:SECRET@db-host:5432/linkgear?sslmode=require
