# SQLite (dev/test) — default if unset
# LINKGEAR_DSN=sqlite://./data/linkgear.db
#
# Postgres (deploy)
# LINKGEAR_DSN=postgres://linkgear:linkgear@localhost:5432/linkgear?sslmode=disable

LINKGEAR_HTTP_ADDR=:8080
LINKGEAR_PUBLIC_URL=http://localhost:8080

# Optional: max concurrent outbound webhook deliveries (default 8)
# LINKGEAR_DELIVERY_WORKERS=8
# Optional: poll interval for pending deliveries (default 2s)
# LINKGEAR_DELIVERY_POLL=2s
